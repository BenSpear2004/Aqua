# Copy this file to .env (same folder) and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# .env is gitignored. Never commit it; this repo is public.

# ---- Database ----
# Use the read-only nl2sql_reader role (db/03_users.sql), never the
# admin login. Host and port come from the Tiger Cloud console.
# If the password contains @ : / # ? or %, URL-encode those characters.
DATABASE_URL=postgresql://nl2sql_reader:CHANGE_ME@HOST:PORT/tsdb?sslmode=require

# Only for the offline embedding indexer (Phase 4), which writes to the
# retrieval schema and nothing else (db/04_retrieval.sql). The web app
# never uses it. Leave blank unless you run the indexer.
INDEXER_DATABASE_URL=postgresql://nl2sql_indexer:CHANGE_ME@HOST:PORT/tsdb?sslmode=require

# ---- Model: Ollama (the backup, on Ben's server) ----
# Where Ollama is running. Ben's server over Tailscale, or
# http://127.0.0.1:11434 for Ollama on your own machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=true
# Default model for questions: gemini (free Gemini Flash-Lite) or ollama. The UI can pick
# either per question; gemini needs GEMINI_API_KEY.
LLM_PROVIDER=gemini
# When a Gemini model is down or out of quota (HTTP 429, 5xx, timeouts),
# try Ollama, then GEMINI_FALLBACK_MODELS, instead of showing an outage.
LLM_FALLBACK=on

# ---- Model: Gemini API (the default) ----
# Used for SQL generation (LLM_PROVIDER=gemini), for embeddings when RETRIEVAL is
# on, and by the offline indexer.
# Use a key from your own Google AI Studio project. Limits are per
# project and per model; see aistudio.google.com/rate-limit.
# gemini-3.5-flash-lite answers in about a second and was the most accurate
# free model in our eval (docs/decisions.md). Gemma 4 is free too but thinks
# before answering (15 to 90 seconds), so it is the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order after Ollama when GEMINI_MODEL is out of quota or down;
# "none" for none.
GEMINI_FALLBACK_MODELS=gemma-4-26b-a4b-it
GEMINI_EMBED_MODEL=gemini-embedding-2

# ---- Retrieval (Phase 4) ----
# on: each question gets only the nearest tables plus similar worked
# examples. Needs GEMINI_API_KEY and an index built with
# python -m nl2sql.retrieval.store. If retrieval fails at question time
# the app falls back to the full schema.
RETRIEVAL=off

# ---- Answer size and caching ----
# on: tell the model how many rows a question asks for. "top 5" gives 5,
# a plural with no number ("least popular movies") gives the top 10, and
# a singular ("the longest film") gives first place plus every tie.
ANSWER_SIZE_RULES=on
# Seconds to reuse a successful answer to the same question and model;
# 0 turns the cache off.
ANSWER_CACHE_SECONDS=600

# ---- Google sign-in (see docs/google-signin.md) ----
# The Google OAuth Web application client ID.
GOOGLE_CLIENT_ID=
# The exact origin users visit. http://localhost:5173 for local work.
APP_ORIGIN=https://aqua-ai.us
# At least 32 random characters; changing it signs everyone out.
SESSION_SECRET=
# Optional; default 3600 seconds, allowed 300 to 86400.
SESSION_MAX_AGE_SECONDS=3600
# Who may query the database. Empty means nobody. Comma-separated.
# Emails must be verified Gmail or Google Workspace accounts.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_GOOGLE_SUBS=
