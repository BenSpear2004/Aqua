# Copy this file to .env (same folder) and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# .env is gitignored. Never commit it; this repo is public.

# ---- Database ----
# Use the read-only nl2sql_reader role (db/03_users.sql), never the
# admin login. Host and port come from the Tiger Cloud console.
# If the password contains @ : / # ? or %, URL-encode those characters.
DATABASE_URL=postgresql://nl2sql_reader:CHANGE_ME@HOST:PORT/tsdb?sslmode=require

# Only for the offline embedding indexer (Phase 4), which writes to the
# retrieval schema and nothing else (db/04_retrieval.sql). The web app
# never uses it. Leave blank unless you run the indexer.
INDEXER_DATABASE_URL=postgresql://nl2sql_indexer:CHANGE_ME@HOST:PORT/tsdb?sslmode=require

# ---- Model: Ollama (default) ----
# Where Ollama is running. Ben's server over Tailscale, or
# http://127.0.0.1:11434 for Ollama on your own machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Reason before answering: slower but more accurate in our tests.
OLLAMA_THINK=true

# ---- Model: Gemini API (backup, free tier) ----
# Used for embeddings when RETRIEVAL is on, and by the offline indexer.
# Generation still runs on Ollama; llm.py has no Gemini path yet.
# Use a key from your own Google AI Studio project. Limits are per
# project; see aistudio.google.com/rate-limit for your daily quota.
# Gemini Flash models allow only ~20 requests a day free, so we use
# Gemma 4, which is free of charge. gemma-4-26b-a4b-it is the faster,
# slightly weaker alternative.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
# Embeddings for retrieval. Changing this model means re-embedding
# everything already stored; record any change in docs/decisions.md.
GEMINI_EMBED_MODEL=gemini-embedding-2

# ---- Retrieval (Phase 4) ----
# on: each question gets only the nearest tables plus similar worked
# examples. Needs GEMINI_API_KEY and an index built with
# python -m nl2sql.retrieval.store. If retrieval fails at question time
# the app falls back to the full schema.
RETRIEVAL=off
